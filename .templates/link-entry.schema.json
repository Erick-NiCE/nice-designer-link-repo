{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LinkEntry",
  "type": "object",
  "required": ["id", "name", "url", "created_at"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Slug or UUID, unique within the designer's links.json"
    },
    "name": {
      "type": "string",
      "description": "Short title of the design"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Link to the design (Figma, FigJam, prototype, etc.)"
    },
    "description": {
      "type": "string",
      "description": "What this design is / where it's at"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "folder": {
      "type": "string",
      "description": "id of a folder listed in this designer's meta.json (defaults to \"uncategorized\")"
    },
    "preview": {
      "type": "object",
      "description": "Best-effort metadata fetched from the URL when the link was added",
      "properties": {
        "title": { "type": "string" },
        "image": { "type": "string", "format": "uri" },
        "favicon": { "type": "string", "format": "uri" }
      }
    }
  }
}
