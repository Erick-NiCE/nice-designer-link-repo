{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LinkEntry",
  "type": "object",
  "required": ["id", "name", "url", "created_at"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Slug or UUID, unique within the designer's links.json"
    },
    "name": {
      "type": "string",
      "description": "Short title of the design"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Link to the design (Figma, FigJam, prototype, etc.)"
    },
    "description": {
      "type": "string",
      "description": "What this design is / where it's at"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
