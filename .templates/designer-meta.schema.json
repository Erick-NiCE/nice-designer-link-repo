{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DesignerMeta",
  "type": "object",
  "required": ["displayName", "folders"],
  "properties": {
    "displayName": { "type": "string" },
    "emoji": { "type": "string", "description": "Cover emoji for this designer's folder tile" },
    "color": { "type": "string", "description": "Hex accent color for this designer's folder tile" },
    "folders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "description": "Slug used in links[].folder" },
          "name": { "type": "string" },
          "emoji": { "type": "string" },
          "color": { "type": "string" }
        }
      }
    }
  }
}
